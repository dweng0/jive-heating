# Copy to .env and edit. Placeholders only; never commit real values.

# Bearer token the Android app sends. Required.
HEATING_API_TOKEN=change-me
# Key that encrypts saved secrets (the broker password) in the database. Required once a broker password is saved;
# keep it, because the service will not start if it is lost or changed. Any long random string, e.g. `openssl rand -hex 32`.
HEATING_SECRET_KEY=change-me
# Mosquitto broker URL. Only fills in connection setup the first time the service starts with an empty database;
# after that the broker is changed in the app (Settings > Connection).
MQTT_URL=tcp://mosquitto:1883
# Broker login. Leave both unset if your broker allows anonymous connections.
# MQTT_USERNAME=heating
# MQTT_PASSWORD=change-me
# Zigbee2MQTT base topic
Z2M_BASE_TOPIC=zigbee2mqtt
# Time zone for schedules (IANA name)
HEATING_TIMEZONE=Europe/London
# SQLite database file
HEATING_DB_PATH=/data/heating.db
# Boiler minimum run and rest, in minutes (stops short-cycling)
BOILER_MIN_RUN_MINUTES=4
BOILER_MIN_REST_MINUTES=5
